    given-names: "Sergei"
    orcid: "https://orcid.org/0009-0008-0586-8200"
repository-code: "https://github.com/Gladskih/native-aot-llvm-bolt"
url: "https://github.com/Gladskih/native-aot-llvm-bolt"
keywords:
  - ".NET"
  - "Native AOT"
  - "LLVM BOLT"
  - "ELF"
  - "post-link optimization"
